{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[a-f0-9]{32}$/)",
        ".write": "auth != null && $room.matches(/^[a-f0-9]{32}$/)",
        "msgs": { "$id": { ".validate": "newData.hasChildren(['c','f']) && newData.child('c').isString() && newData.child('c').val().length < 4500000 && newData.child('f').isString() && newData.child('f').val().length <= 64" } },
        "ctl":  { "$id": { ".validate": "newData.hasChildren(['c','f']) && newData.child('c').isString() && newData.child('c').val().length < 4500000 && newData.child('f').isString() && newData.child('f').val().length <= 64" } },
        "pres": { "$id": { ".validate": "newData.hasChildren(['c','f']) && newData.child('c').isString() && newData.child('c').val().length < 4500000 && newData.child('f').isString() && newData.child('f').val().length <= 64" } },
        "$other": { ".validate": false }
      }
    }
  }
}